---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  lang?: "en" | "ja";
  siteName?: string;
  ogImageAlt?: string;
}

const {
  lang = "ja",
  title,
  description = lang === "ja"
    ? "主要AIモデルのスループット・価格・能力を一覧比較。OpenAI、Anthropic、Google、xAIなどの最新データをリアルタイムで確認できます。"
    : "Compare AI model throughput and pricing across frontier models from OpenAI, Anthropic, Google, xAI, and more.",
  siteName = lang === "ja"
    ? "AIモデル比較 — AIドリブン推進室"
    : "AI Model Comparison — AI Driven Office",
  ogImageAlt = lang === "ja"
    ? "AIモデル比較ダッシュボード — AIドリブン推進室"
    : "AI Model Comparison Dashboard — AI Driven Office",
} = Astro.props;

const ogLocale = lang === "ja" ? "ja_JP" : "en_US";
const altLocale = lang === "ja" ? "en_US" : "ja_JP";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonicalUrl = new URL(base, Astro.site).href;
const ogImageUrl = new URL(`${base}og.jpg`, Astro.site).href;
const mdUrl = new URL(`${base}data.md`, Astro.site).href;
const llmsTxtUrl = new URL(`${base}llms.txt`, Astro.site).href;
const buildDate = new Date().toISOString().split("T")[0];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#08121a" />
    <meta name="date" content={buildDate} />
    <meta name="last-modified" content={buildDate} />

    <!-- hreflang — same URL serves both languages client-side -->
    <link rel="alternate" hreflang="ja" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- RSS feed -->
    <link rel="alternate" type="application/rss+xml" title="AI Model Comparison — News" href={`${base}feed.xml`} />

    <!-- AI / Bot discoverability -->
    <link rel="alternate" type="text/markdown" href={mdUrl} title="AI Model Comparison (Markdown)" />
    <link rel="author" href={llmsTxtUrl} type="text/plain" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="2848" />
    <meta property="og:image:height" content="1504" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={altLocale} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <!-- Fonts: preconnect, then non-blocking load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Mono:wght@400;700&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
      media="print"
      onload="this.setAttribute('media','all')"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Mono:wght@400;700&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
      />
    </noscript>

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": siteName,
      "description": description,
      "url": canonicalUrl,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Web",
      "inLanguage": lang,
      "dateModified": buildDate,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
      },
      "image": ogImageUrl,
      "creator": {
        "@type": "Organization",
        "name": "AI Driven Office (AIドリブン推進室)",
        "parentOrganization": {
          "@type": "Organization",
          "name": "CyberAgent, Inc.",
          "url": "https://www.cyberagent.co.jp/"
        }
      }
    })} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Dataset",
      "name": lang === "ja" ? "AIモデル スループット＆価格データ" : "AI Model Throughput & Pricing Data",
      "description": lang === "ja"
        ? "主要AIモデル（OpenAI、Anthropic、Google、xAI、Cerebras、SiliconFlow）のスループット（トークン/秒）、価格、能力スコアのデータセット"
        : "Throughput (tokens/sec), pricing ($/M tokens), and capability scores for frontier AI models from OpenAI, Anthropic, Google, xAI, Cerebras, and SiliconFlow.",
      "url": canonicalUrl,
      "dateModified": buildDate,
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "distribution": {
        "@type": "DataDownload",
        "encodingFormat": "text/markdown",
        "contentUrl": mdUrl,
      },
      "creator": {
        "@type": "Organization",
        "name": "AI Driven Office (AIドリブン推進室)",
      }
    })} />

    <!-- Detect stored/browser lang before paint to avoid flash -->
    <script is:inline>
      (function(){
        var s=localStorage.getItem('aid-lang');
        if(s==='en'||s==='ja'){document.documentElement.lang=s;return}
        var b=(navigator.language||'').toLowerCase();
        var l=b.startsWith('ja')?'ja':'en';
        document.documentElement.lang=l;
        localStorage.setItem('aid-lang',l);
      })();
    </script>

    <ClientRouter />
  </head>
  <body class="px-6 py-12 sm:py-16">
    <main transition:animate="fade">
      <slot />
    </main>

    <!-- Cloudflare Web Analytics — free, no cookies, ~1KB -->
    <!-- Get your token: https://dash.cloudflare.com → Web Analytics → Add Site -->
    {import.meta.env.PUBLIC_CF_BEACON && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token":"${import.meta.env.PUBLIC_CF_BEACON}"}`}
      />
    )}
  </body>
</html>
