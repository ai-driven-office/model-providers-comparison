---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  lang?: "en" | "ja";
  siteName?: string;
  ogImageAlt?: string;
  canonicalPath?: string;
  alternateJaPath?: string;
  alternateEnPath?: string;
}

const {
  lang = "ja",
  title,
  description = lang === "ja"
    ? "主要AIモデルのスループット・価格・能力を一覧比較。OpenAI、Anthropic、Google、xAIなどの最新データをリアルタイムで確認できます。"
    : "Compare AI model throughput and pricing across frontier models from OpenAI, Anthropic, Google, xAI, and more.",
  siteName = lang === "ja"
    ? "AIモデル比較 — AIドリブン推進室"
    : "AI Model Comparison — AI Driven Office",
  ogImageAlt = lang === "ja"
    ? "AIモデル比較ダッシュボード — AIドリブン推進室"
    : "AI Model Comparison Dashboard — AI Driven Office",
  canonicalPath = Astro.url.pathname,
  alternateJaPath = canonicalPath,
  alternateEnPath = canonicalPath,
} = Astro.props;

const ogLocale = lang === "ja" ? "ja_JP" : "en_US";
const altLocale = lang === "ja" ? "en_US" : "ja_JP";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const alternateJaUrl = new URL(alternateJaPath, siteUrl).href;
const alternateEnUrl = new URL(alternateEnPath, siteUrl).href;
const ogImageUrl = new URL(`${base}og.jpg`, siteUrl).href;
const mdUrl = new URL(`${base}data.md`, siteUrl).href;
const llmsTxtUrl = new URL(`${base}llms.txt`, siteUrl).href;
const buildDate = new Date().toISOString().split("T")[0];
const analyticsEnabled = import.meta.env.PROD;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#08121a" />
    <meta name="date" content={buildDate} />
    <meta name="last-modified" content={buildDate} />

    <link rel="alternate" hreflang="ja" href={alternateJaUrl} />
    <link rel="alternate" hreflang="en" href={alternateEnUrl} />
    <link rel="alternate" hreflang="x-default" href={alternateJaUrl} />

    <!-- RSS feed -->
    <link rel="alternate" type="application/rss+xml" title="AI Model Comparison — News" href={`${base}feed.xml`} />

    <!-- AI / Bot discoverability -->
    <link rel="alternate" type="text/markdown" href={mdUrl} title="AI Model Comparison (Markdown)" />
    <link rel="author" href={llmsTxtUrl} type="text/plain" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="2848" />
    <meta property="og:image:height" content="1504" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={altLocale} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <!-- Fonts: preconnect → preload CSS → non-blocking stylesheet
         - Inter variable (opsz + wght): optical sizing adapts stroke contrast
           to rendered size; single file replaces 6 static weights
         - JetBrains Mono: code font with ligatures (=> != >= === |> etc.)
         - Zen Kaku Gothic New: geometric JP sans by Yoshimichi Ohira;
           Google Fonts auto-subsets by unicode-range (~120 small slices)
         - Space Mono: static (no variable version available) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Zen+Kaku+Gothic+New:wght@300;400;500;700;900&family=Space+Mono:wght@400;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Zen+Kaku+Gothic+New:wght@300;400;500;700;900&family=Space+Mono:wght@400;700&display=swap"
      media="print"
      onload="this.setAttribute('media','all')"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Zen+Kaku+Gothic+New:wght@300;400;500;700;900&family=Space+Mono:wght@400;700&display=swap"
      />
    </noscript>

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": siteName,
      "description": description,
      "url": canonicalUrl,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Web",
      "inLanguage": lang,
      "dateModified": buildDate,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
      },
      "image": ogImageUrl,
      "creator": {
        "@type": "Organization",
        "name": "AI Driven Office (AIドリブン推進室)",
        "parentOrganization": {
          "@type": "Organization",
          "name": "CyberAgent, Inc.",
          "url": "https://www.cyberagent.co.jp/"
        }
      }
    })} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Dataset",
      "name": lang === "ja" ? "AIモデル スループット＆価格データ" : "AI Model Throughput & Pricing Data",
      "description": lang === "ja"
        ? "主要AIモデル（OpenAI、Anthropic、Google、xAI、Cerebras、SiliconFlow）のスループット（トークン/秒）、価格、能力スコアのデータセット"
        : "Throughput (tokens/sec), pricing ($/M tokens), and capability scores for frontier AI models from OpenAI, Anthropic, Google, xAI, Cerebras, and SiliconFlow.",
      "url": canonicalUrl,
      "dateModified": buildDate,
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "distribution": {
        "@type": "DataDownload",
        "encodingFormat": "text/markdown",
        "contentUrl": mdUrl,
      },
      "creator": {
        "@type": "Organization",
        "name": "AI Driven Office (AIドリブン推進室)",
      }
    })} />

    <!-- Persist route language for client-side helpers -->
    <script is:inline>
      (function(){
        localStorage.setItem('aid-lang', {JSON.stringify(lang)});
      })();
    </script>

    {analyticsEnabled && (
      <>
        <!-- Google Analytics 4 -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MNPRWQE87B"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-MNPRWQE87B', {
            send_page_view: true,
            cookie_flags: 'SameSite=None;Secure',
          });
          window.gtag = gtag;
        </script>
      </>
    )}

    <ClientRouter />
  </head>
  <body class="px-6 py-6 sm:py-10">
    <main transition:animate="fade">
      <slot />
    </main>

    {analyticsEnabled && (
      <script is:inline>
        document.addEventListener('astro:page-load', function () {
          if (typeof gtag === 'function') {
            gtag('config', 'G-MNPRWQE87B', {
              page_path: window.location.pathname,
              page_title: document.title,
            });
          }
        });
      </script>
    )}
  </body>
</html>
