---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ModelDashboardShell from "../components/ModelDashboardShell.astro";

const i18nEntries = await getCollection("i18n");
const i18n = Object.fromEntries(
  i18nEntries.map((e) => [e.id, e.data])
) as Record<string, Record<string, string>>;

const providerEntries = await getCollection("providers");
const providerMap = Object.fromEntries(
  providerEntries.map((p) => [p.id, p.data])
);

const modelEntries = await getCollection("models");
const models = modelEntries
  .filter((entry) => !entry.data.hidden)
  .map((entry) => ({
    ...entry.data,
    providerId: entry.data.provider,
    provider: providerMap[entry.data.provider]?.name ?? entry.data.provider,
  }));

const providers = providerEntries.map((p) => ({
  id: p.id,
  ...p.data,
}));

const newsEntries = await getCollection("news");
const news = newsEntries
  .map((e) => e.data)
  .sort((a, b) => b.timestamp - a.timestamp);

const buildDate = new Date().toISOString().split("T")[0];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const shareUrl = new URL(base, Astro.site ?? Astro.url).href;
---

<BaseLayout
  lang="ja"
  title={i18n.ja?.ogTitle ?? "AIモデル比較 — AIドリブン推進室"}
  description={i18n.ja?.ogDescription}
  siteName={i18n.ja?.ogSiteName}
  ogImageAlt={i18n.ja?.ogImageAlt}
  canonicalPath={base}
  alternateJaPath={base}
  alternateEnPath={`${base}en/`}
>
  <ModelDashboardShell
    models={models}
    providers={providers}
    news={news}
    i18n={i18n}
    buildDate={buildDate}
    lang="ja"
    shareUrl={shareUrl}
  />
</BaseLayout>
