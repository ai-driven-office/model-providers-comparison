---
import { getCollection } from "astro:content";
import "../styles/global.css";

const i18nEntries = await getCollection("i18n");
const i18n = Object.fromEntries(
  i18nEntries.map((e) => [e.id, e.data])
) as Record<string, Record<string, string>>;

const providerEntries = await getCollection("providers");
const providerMap = Object.fromEntries(
  providerEntries.map((p) => [p.id, p.data])
);

const modelEntries = await getCollection("models");
const models = modelEntries
  .filter((entry) => !entry.data.hidden)
  .map((entry) => ({
    ...entry.data,
    providerId: entry.data.provider,
    provider: providerMap[entry.data.provider]?.name ?? entry.data.provider,
  }));

const providers = providerEntries.map((p) => ({
  id: p.id,
  ...p.data,
}));

import BoothSlideshow from "../components/BoothSlideshow";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>AI Model Comparison — Booth Display</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#08121a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Mono:wght@400;700&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
    />

    <style>
      /* Let the React stage fit any viewport and preserve aspect ratio */
      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #08121a;
        color: #fff;
        cursor: default;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body > * {
        width: 100%;
        height: 100%;
      }
    </style>
  </head>
  <body>
    <BoothSlideshow
      models={models}
      providers={providers}
      i18n={i18n}
      client:only="react"
    />
  </body>
</html>
